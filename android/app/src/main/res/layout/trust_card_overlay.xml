<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/trust_card_root"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E293B"
    android:padding="16dp"
    android:elevation="12dp">

    <!-- Header: Company & Risk Verdict -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/trust_card_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Entity Verification"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/trust_card_risk_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#EF4444"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="CRITICAL 100%"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Recommendation Box -->
    <TextView
        android:id="@+id/trust_card_recommendation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#334155"
        android:padding="10dp"
        android:text="🚨 CRITICAL ALERT: Unlicensed entity found in SEC Thailand Alert List. Do NOT transfer funds."
        android:textColor="#FCA5A5"
        android:textSize="12sp" />

    <!-- 3 Pillars Breakdown -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:text="Regulatory"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/score_regulatory"
                android:text="40/40"
                android:textColor="#EF4444"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:text="SEO/Domain"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/score_seo"
                android:text="25/30"
                android:textColor="#F97316"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:text="Behavioral"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/score_behavioral"
                android:text="30/30"
                android:textColor="#EF4444"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Detected Flags List -->
    <TextView
        android:id="@+id/trust_card_flags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="🚩 Guaranteed Return, FOMO Pressure, Young Domain (&lt;6mo), Mule Account"
        android:textColor="#FDBA74"
        android:textSize="11sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_ocr_scan"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="📸 Scan Screen"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_dismiss_card"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Dismiss"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
