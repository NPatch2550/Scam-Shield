<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍 Before You Invest"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Anti-SEO / Anti-AEO Corporate Authenticity Engine"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Search Input & Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <EditText
            android:id="@+id/et_search_query"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/badge_safe_rounded"
            android:backgroundTint="#131C2E"
            android:paddingHorizontal="14dp"
            android:hint="Company name, URL, or Bank Account"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_run_search"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#2563EB"
            android:text="Check"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Quick Example Chips for Easy Testing -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chip_alphagold"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#1E293B"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="AlphaGold (Fake Broker)"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chip_kbank"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#1E293B"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="KasikornBank (Legit)"
                android:textColor="#34D399"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chip_domain"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#1E293B"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="cryptovaultpro.io (Clone)"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chip_mule"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:backgroundTint="#1E293B"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="1234567890 (Mule Account)"
                android:textColor="#F87171"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <ProgressBar
        android:id="@+id/search_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="16dp"
        android:visibility="gone" />

    <!-- Result Card -->
    <ScrollView
        android:id="@+id/search_result_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#131C2E">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tv_result_company"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Company Name"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_result_verdict"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="CRITICAL RISK 100%"
                    android:textColor="#EF4444"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_result_recommendation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#1E293B"
                    android:padding="12dp"
                    android:text="Recommendation details..."
                    android:textColor="#FEE2E2"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

                <!-- Regulatory Match Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="REGULATORY STATUS (SEC / DBD / BOT)"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_regulatory_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="• Found on SEC Thailand Alert List (Unlicensed)\n• 47 Community reports"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />

                <!-- Domain / SEO Analysis Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="SEO / DOMAIN AUTHENTICITY"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_seo_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="• Domain age: 2 months old (High Risk)\n• Astroturfed fake PR articles detected"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>

</LinearLayout>
