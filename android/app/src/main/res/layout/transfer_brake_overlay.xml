<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/transfer_brake_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#DC2626"
    android:orientation="vertical"
    android:padding="20dp"
    android:elevation="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="🛑 FINANCIAL TRANSFER BRAKE ACTIVE"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/transfer_brake_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="You just switched from a flagged high-risk investment chat into your mobile banking app. The account you are about to transfer to has been flagged as a potential MULE ACCOUNT (บัญชีม้า) or unregistered entity."
        android:textColor="#FEE2E2"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/transfer_brake_advice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="⚠️ Legitimate investment brokers NEVER ask for transfers to personal bank accounts. Report to SEC 1207 or Cyber Police 1441 immediately."
        android:textColor="#FEF08A"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel_transfer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#FFFFFF"
            android:text="CANCEL TRANSFER"
            android:textColor="#DC2626"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_override_brake"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="#7F1D1D"
            android:text="I Understand Risk"
            android:textColor="#FCA5A5" />
    </LinearLayout>

</LinearLayout>
